# ==============================================================================
# Krishi AI – Commercial AgriTech Environment Configuration
# ==============================================================================

# 0. Application Runtime Mode ('production' or 'development')
# In 'production', test credentials and 1-click logins are disabled; tables start clean.
# In 'development', seeded test accounts are available for local evaluation.
KRISHI_ENV=production

# 1. Official Indian Mandi Prices (data.gov.in AGMARKNET Resource)
# Register for a free API key at: https://data.gov.in
# Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_API_KEY=

# 2. OpenRouteService (ORS) Matrix & Road Routing
# Free tier key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# 3. Google Gemini API (Multimodal AI & Agricultural Advisory)
# Free tier key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 4. Pl@ntNet API (Botanical Species Identification)
# Free tier key at: https://my.plantnet.org/
PLANTNET_API_KEY=

# Optional: Open-Meteo & NASA POWER do not require API keys for non-commercial educational tiers
